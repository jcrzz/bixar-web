# Base de datos (Neon → https://neon.tech)
# DATABASE_URL: conexión "pooled" (el host termina en -pooler), se usa en runtime.
# DIRECT_URL:   conexión directa, se usa solo para `prisma migrate`.
# Las dos se necesitan; la app nunca usa DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secreto para firmar los JWT de sesión del panel.
# Generá uno con: openssl rand -base64 32
# Mínimo 32 caracteres. Sin esto la app falla en runtime (a propósito).
AUTH_SECRET=""

# Almacenamiento de imágenes (Vercel Blob).
# Se obtiene en Vercel → Project → Storage → Blob → Connect.
# Sin esto en producción el upload falla en lugar de perder archivos.
BLOB_READ_WRITE_TOKEN=""

# Credenciales que usa `pnpm run db:seed` para crear el admin.
# Solo se usan al correr el seed; no hacen falta en Vercel.
#
# OJO: el seed hace upsert POR EMAIL, así que **crea** un admin, no renombra uno
# que ya exista. Si cambiás esta dirección y corrés el seed sobre una base que ya
# tiene un admin con otra, te quedan DOS cuentas con acceso al panel. Para
# cambiar el email de la cuenta existente, editá la fila del admin directamente.
SEED_ADMIN_EMAIL="bixar.ingenieria@gmail.com"
SEED_ADMIN_PASSWORD=""

# --- Envío de emails (Resend) -------------------------------------------------
# API key: Resend → API Keys. Sin esto, la recuperación de contraseña y el
# formulario de contacto guardan el dato pero no envían el aviso.
RESEND_API_KEY=""

# Remitente. El dominio tiene que estar VERIFICADO en Resend; si no, cada envío
# falla con invalid_from_address. El valor por defecto es este mismo.
RESEND_FROM_EMAIL="Bixar <no-reply@bixar.com.ar>"

# A qué inbox llegan los mensajes del formulario de contacto.
# Por defecto usa el email público del sitio (lib/site.ts).
CONTACT_NOTIFICATION_EMAIL=""